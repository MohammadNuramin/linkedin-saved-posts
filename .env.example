# LinkedIn credentials (optional — only needed for automated login)
# If left blank, the scraper will use your existing Chrome browser session
LINKEDIN_EMAIL=your-email@example.com
LINKEDIN_PASSWORD=your-password

# Optional: limit number of posts to scrape (0 = all)
MAX_POSTS=0

# Chrome profile (optional — defaults to LOCALAPPDATA path and "Default" profile)
# CHROME_USER_DATA=C:/Users/YourName/AppData/Local/Google/Chrome/User Data
# CHROME_PROFILE=Default
# Persistent Playwright profile used by scheduled syncs
# LINKEDIN_BROWSER_DATA=./.browser-profile
# LINKEDIN_LOGIN_WAIT_MS=300000

# Text-only R3 search services (optional overrides)
# R3_EMBEDDING_MODEL=tencent/R3-embedding-0.6b
# R3_RERANK_MODEL=tencent/R3-rerank-0.6b
# R3_SEARCH_PORT=8691
# R3_EMBEDDING_URL=http://localhost:8691
# R3_RERANK_URL=http://localhost:8691
# R3_SERVICE_IMAGE=linkedin-r3-search:local
# R3_HEALTH_TIMEOUT_MS=600000
